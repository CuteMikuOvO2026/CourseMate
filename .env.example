# CourseMate 环境变量示例
# 复制为仓库根目录的 .env 后会由 load_settings() 自动加载；进程环境变量优先。

# 数据目录：SQLite、上传文件、secret.key 默认都放在这里；相对路径按仓库根目录解析
COURSEMATE_DATA_DIR=./data

# 数据库；默认 sqlite:///<数据目录>/coursemate.db。覆盖时建议使用绝对路径
# COURSEMATE_DATABASE_URL=sqlite:///D:/path/to/coursemate.db

# 会话签名密钥；留空时自动生成并保存到 <data>/secret.key
# COURSEMATE_SECRET_KEY=

# 单文件上传上限（MB）
COURSEMATE_MAX_UPLOAD_MB=50

# 生成 provider：offline（默认，摘录式）| openai（OpenAI 兼容接口）
COURSEMATE_LLM_PROVIDER=offline
# COURSEMATE_LLM_BASE_URL=https://api.deepseek.com/v1
# COURSEMATE_LLM_API_KEY=
# COURSEMATE_LLM_MODEL=deepseek-chat

# HTTPS 部署时设为 1，Cookie 加 Secure
COURSEMATE_COOKIE_SECURE=0

# 向量化 provider：hash（默认，零依赖，中文 bigram + 哈希 TF-IDF）| openai（OpenAI 兼容 /embeddings）
COURSEMATE_EMBEDDING_PROVIDER=hash
# COURSEMATE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# COURSEMATE_EMBEDDING_API_KEY=
# COURSEMATE_EMBEDDING_MODEL=BAAI/bge-m3
# COURSEMATE_EMBEDDING_DIM=1024
# COURSEMATE_EMBEDDING_BATCH=32

# 重排（默认关闭；启用后在 RRF Top-50 上再精排回 Top-K）
COURSEMATE_RERANK_ENABLED=0
# COURSEMATE_RERANK_BASE_URL=https://api.jina.ai/v1
# COURSEMATE_RERANK_API_KEY=
# COURSEMATE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
